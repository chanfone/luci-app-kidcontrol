#!/bin/sh /etc/rc.common

START=99
STOP=10

. /lib/functions.sh

RULE_FILE=""
LAN_IFACE="br-lan"
AGH_PORT="3053"
GLOBAL_ENABLED="1"

load_settings() {
	config_load kidcontrol
	config_get GLOBAL_ENABLED main enabled 1
	config_get LAN_IFACE main lan_iface br-lan
	config_get AGH_PORT main agh_port 3053
	config_get RULE_FILE main rule_file /etc/nftables.d/20-adguard-parental-test.nft
}

valid_mac() {
	echo "$1" | grep -Eiq "^([0-9a-f]{2}:){5}[0-9a-f]{2}$"
}

valid_ip() {
	echo "$1" | grep -Eq "^([0-9]{1,3}\.){3}[0-9]{1,3}$"
}

write_dns_rule() {
	local section="$1"
	local enabled mac ip name
	config_get enabled "$section" enabled 1
	[ "$GLOBAL_ENABLED" = "1" ] || return 0
	[ "$enabled" = "1" ] || return 0
	config_get mac "$section" mac
	config_get ip "$section" ip
	config_get name "$section" name "$section"
	mac="$(echo "$mac" | tr "A-F" "a-f")"
	if valid_mac "$mac"; then
		printf "\tiifname \"%s\" ether saddr %s udp dport 53 counter redirect to :%s comment \"KidControl DNS udp %s\"\n" "$LAN_IFACE" "$mac" "$AGH_PORT" "$name"
		printf "\tiifname \"%s\" ether saddr %s tcp dport 53 counter redirect to :%s comment \"KidControl DNS tcp %s\"\n" "$LAN_IFACE" "$mac" "$AGH_PORT" "$name"
	elif valid_ip "$ip"; then
		printf "\tiifname \"%s\" ip saddr %s udp dport 53 counter redirect to :%s comment \"KidControl DNS udp %s ip-fallback\"\n" "$LAN_IFACE" "$ip" "$AGH_PORT" "$name"
		printf "\tiifname \"%s\" ip saddr %s tcp dport 53 counter redirect to :%s comment \"KidControl DNS tcp %s ip-fallback\"\n" "$LAN_IFACE" "$ip" "$AGH_PORT" "$name"
	fi
}

write_dot_rule() {
	local section="$1"
	local enabled mac ip block_dot name
	config_get enabled "$section" enabled 1
	[ "$GLOBAL_ENABLED" = "1" ] || return 0
	[ "$enabled" = "1" ] || return 0
	config_get block_dot "$section" block_dot 1
	[ "$block_dot" = "1" ] || return 0
	config_get mac "$section" mac
	config_get ip "$section" ip
	config_get name "$section" name "$section"
	mac="$(echo "$mac" | tr "A-F" "a-f")"
	if valid_mac "$mac"; then
		printf "\tiifname \"%s\" ether saddr %s tcp dport 853 counter reject with tcp reset comment \"KidControl block DoT tcp %s\"\n" "$LAN_IFACE" "$mac" "$name"
		printf "\tiifname \"%s\" ether saddr %s udp dport 853 counter reject comment \"KidControl block DoT udp %s\"\n" "$LAN_IFACE" "$mac" "$name"
	elif valid_ip "$ip"; then
		printf "\tiifname \"%s\" ip saddr %s tcp dport 853 counter reject with tcp reset comment \"KidControl block DoT tcp %s ip-fallback\"\n" "$LAN_IFACE" "$ip" "$name"
		printf "\tiifname \"%s\" ip saddr %s udp dport 853 counter reject comment \"KidControl block DoT udp %s ip-fallback\"\n" "$LAN_IFACE" "$ip" "$name"
	fi
}

generate_rules() {
	load_settings
	mkdir -p "$(dirname "$RULE_FILE")"
	{
		echo "chain kidcontrol_prerouting {"
		printf "\ttype nat hook prerouting priority dstnat - 2; policy accept;\n"
		config_foreach write_dns_rule device
		echo "}"
		echo
		echo "chain kidcontrol_forward {"
		printf "\ttype filter hook forward priority filter - 2; policy accept;\n"
		config_foreach write_dot_rule device
		echo "}"
	} > "$RULE_FILE"
}

reload() {
	generate_rules
	fw4 check >/tmp/kidcontrol-fw4-check.log 2>&1 || {
		cat /tmp/kidcontrol-fw4-check.log >&2
		return 1
	}
	/etc/init.d/firewall reload >/dev/null 2>&1
}

start() {
	reload
}

restart() {
	reload
}

stop() {
	load_settings
	{
		echo "chain kidcontrol_prerouting {"
		printf "\ttype nat hook prerouting priority dstnat - 2; policy accept;\n"
		echo "}"
		echo
		echo "chain kidcontrol_forward {"
		printf "\ttype filter hook forward priority filter - 2; policy accept;\n"
		echo "}"
	} > "$RULE_FILE"
	/etc/init.d/firewall reload >/dev/null 2>&1
}
